PORT=4000
BASE_DOMAIN=teknulugycard.com
PUBLIC_API_URL=https://back.teknulugycard.com
CORS_ORIGINS=https://admin.teknulugycard.com,http://localhost:5173
# generate with: openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-string
# first admin account (created on first start only)
ADMIN_EMAIL=admin@teknulugycard.com
ADMIN_PASSWORD=ChangeMe123!

# Apple Wallet (optional) — see README "Apple Wallet"
WALLET_PASS_TYPE_ID=pass.com.teknulugy.tekcard
WALLET_TEAM_ID=YOURTEAMID
WALLET_ORG_NAME=Teknulugy
WALLET_CERT_DIR=/root/.secrets/tekcard-wallet
WALLET_KEY_PASSPHRASE=
